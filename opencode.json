          "name": "Qwen3 Coder 30B A3B (Local)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "project_memory": {
      "type": "local",
      "command": [
        "/home/xzerow/Documents/rag-tool/.venv/bin/python",
        "/home/xzerow/Documents/rag-tool/rag_mcp.py"
      ],
      "enabled": true
    }
  }
}
